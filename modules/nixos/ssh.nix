{ config, lib, ... }:
{
  services.openssh = {
    enable = true;
    # Ed25519 only: no RSA host key is generated or offered. On caixa this
    # key is generated by machines/caixa/install.sh before nixos-install,
    # since sops-nix also uses it as the host's age identity.
    hostKeys = [
      { type = "ed25519"; path = "/etc/ssh/ssh_host_ed25519_key"; }
    ];
    settings = {
      # Keys only: no password, no keyboard-interactive, nothing else.
      AuthenticationMethods = "publickey";
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
      AllowUsers = [ "henrique" ];
      # A connection is dropped after 3 rejected keys. A client offering
      # every key in its agent can hit this before the right one; point it
      # at the right key (IdentitiesOnly + IdentityFile) if so.
      MaxAuthTries = 3;
      # Time to finish authenticating. ssh asks for the key's passphrase
      # only after connecting, so this includes typing it: 20s was too
      # short for a long one. (With the key in ssh-agent it's instant.)
      LoginGraceTime = 60;
      # Logs the fingerprint of the key that logged in.
      LogLevel = "VERBOSE";
      # Post-quantum key exchange only: ML-KEM-768 + X25519 hybrid
      # (RFC 10042). A connection recorded today can't be decrypted later by
      # a quantum computer, and X25519 still holds if ML-KEM falls. Clients
      # need OpenSSH >= 9.9; anything older can't connect at all.
      KexAlgorithms = [ "mlkem768x25519-sha256" ];
      # Ciphers/Macs stay NixOS' defaults: AEAD/ETM only.
    };
  };

  # Local network only. Anything arriving over loopback is refused before
  # sshd sees it -- that's how a Cloudflare Tunnel (cloudflared.nix) would
  # deliver it, so SSH can't be reached through one even if a public
  # hostname is pointed at ssh://localhost:22. Inserted at the top of
  # nixos-fw, ahead of its blanket loopback accept. (`ssh localhost` on the
  # machine itself is refused too.)
  networking.firewall.extraCommands = lib.concatMapStrings (port: ''
    ip46tables -I nixos-fw 1 -i lo -p tcp --dport ${toString port} -j nixos-fw-log-refuse
  '') config.services.openssh.ports;

  # 3 failed attempts and the source IP is banned from every port, for an
  # hour, doubling on each repeat (up to a week). "aggressive" also counts
  # rejected keys and connections dropped before authenticating, not just
  # wrong passwords (there are none to get wrong here).
  services.fail2ban = {
    enable = true;
    maxretry = 3;
    bantime = "1h";
    bantime-increment = {
      enable = true;
      maxtime = "168h";
    };
    jails.sshd.settings.mode = "aggressive";
  };
}
