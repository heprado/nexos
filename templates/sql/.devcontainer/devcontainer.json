{
  // Image built by nexos (devcontainers/images.nix) and loaded into
  // podman by devc-load -- never pulled from a registry.
  "name": "sql",
  "image": "localhost/nexos/devcontainer-sql:latest",
  // Runs on the host before the container starts: builds and loads the
  // image when podman doesn't have this version yet.
  "initializeCommand": "devc-load sql",
  // Rootless podman: the container's dev (uid 1000) is your own uid, so
  // files in the repo stay yours.
  "runArgs": ["--userns=keep-id"],
  "containerUser": "dev",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  // Postgres runs in the container itself (socket in /tmp, database
  // "app", user dev, no password); its data survives rebuilds of the
  // container in a volume of its own per project.
  "mounts": [
    "source=pgdata-${localWorkspaceFolderBasename},target=/home/dev/pgdata,type=volume"
  ],
  "postStartCommand": "pg-start"
}
